# Скопируй в .env.local и подставь свои ключи.
# .env.local в .gitignore и НИКОГДА не попадает ни в репозиторий, ни в браузер:
# ключи читает только дев-сервер Vite (src/server/devProxy.ts) и подставляет
# заголовок авторизации на своей стороне. В бандл фронта они не собираются —
# именно поэтому переменные названы без префикса VITE_ (Vite отдаёт клиенту
# только VITE_*, всё остальное остаётся на сервере).

# Groq — распознавание речи (Whisper) и озвучка (Orpheus). Ключ: console.groq.com
GROQ_API_KEY=

# Cerebras — основная модель диалога, щедрый бесплатный лимит. cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenAI — только для режима Realtime (этап 5). Без него всё работает на пайплайне.
OPENAI_API_KEY=

# Какой транспорт голоса использовать: pipeline (бесплатный) | realtime (платный)
BROKER_CALL_TRANSPORT=pipeline
