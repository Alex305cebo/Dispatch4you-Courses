{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "broker-call",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "broker-call",
        "run",
        "dev"
      ],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "site-root",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "_range_server.py"
      ],
      "autoPort": true
    },
    {
      "name": "office4dispatch-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "adventure",
        "run",
        "web",
        "--",
        "--port",
        "8083"
      ],
      "port": 8083
    },
    {
      "name": "map-trainer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "map-trainer",
        "run",
        "dev",
        "--",
        "--port",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "survivors",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,http.server;os.chdir(r'C:/DispatcherTraining/games/Survivors');p=int(os.environ.get('PORT','0'));s=http.server.ThreadingHTTPServer(('',p),http.server.SimpleHTTPRequestHandler);s.allow_reuse_address=True;s.serve_forever()"
      ],
      "port": 8098
    },
    {
      "name": "tetris",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,http.server;os.chdir(r'C:/DispatcherTraining/games/Tetris');p=int(os.environ.get('PORT','0'));s=http.server.ThreadingHTTPServer(('',p),http.server.SimpleHTTPRequestHandler);s.allow_reuse_address=True;s.serve_forever()"
      ],
      "port": 8099
    }
  ]
}
